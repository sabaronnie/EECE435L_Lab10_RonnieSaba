pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        VIRTUAL_ENV = 'venv'
    }

    stages {
        stage('Setup') {
            steps {
                sh '''
                    python3 -m venv "$VIRTUAL_ENV"
                    "$VIRTUAL_ENV/bin/python" -m pip install -r requirements.txt
                    mkdir -p reports
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '"$VIRTUAL_ENV/bin/python" -m flake8 app.py deploy_local.py tests'
            }
        }

        stage('Test') {
            steps {
                sh '"$VIRTUAL_ENV/bin/python" -m pytest'
            }
        }

        stage('Coverage') {
            steps {
                sh '''
                    "$VIRTUAL_ENV/bin/python" -m coverage run --source=app -m pytest
                    "$VIRTUAL_ENV/bin/python" -m coverage report -m
                    "$VIRTUAL_ENV/bin/python" -m coverage xml -o reports/coverage.xml
                    "$VIRTUAL_ENV/bin/python" -m coverage html -d reports/htmlcov
                '''
            }
        }

        stage('Security Scan') {
            steps {
                sh '''
                    "$VIRTUAL_ENV/bin/python" -m bandit app.py deploy_local.py -f txt -o reports/bandit.txt
                    cat reports/bandit.txt
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    "$VIRTUAL_ENV/bin/python" deploy_local.py \\
                        --destination "$HOME/jenkins_deployments/Python-CI-CD_RonnieSaba" \\
                        > reports/deployment.txt
                    cat reports/deployment.txt
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
        }
        cleanup {
            cleanWs()
        }
    }
}
