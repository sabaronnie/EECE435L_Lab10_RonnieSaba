pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
    }

    stages {
        stage('Setup') {
            steps {
                dir('jenkins_project') {
                    sh '''
                        python3 -m venv "$VIRTUAL_ENV"
                        "$VIRTUAL_ENV/bin/python" -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Lint') {
            steps {
                dir('jenkins_project') {
                    sh '"$VIRTUAL_ENV/bin/python" -m flake8 app.py'
                }
            }
        }

        stage('Test') {
            steps {
                dir('jenkins_project') {
                    sh '"$VIRTUAL_ENV/bin/python" -m pytest'
                }
            }
        }

        stage('Deploy') {
            steps {
                // Part 3 uses a placeholder; deployment is implemented in Part 4.
                echo 'Deploying application...'
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
